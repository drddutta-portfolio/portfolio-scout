// PortfolioAI — environment variable template
// NAMES AND EMPTY PLACEHOLDERS ONLY. Never commit a real value to this file.
// Real values live only in the secure secret store / local untracked .env file.
//
// Note: the platform reserves the VITE_ and SUPABASE_ prefixes for its own
// managed integrations, so PortfolioAI's dedicated-project variables use the
// PORTFOLIOAI_ prefix. Values are entered via the secure secret store.

# --- Dedicated Supabase project (publishable key only; RLS is the boundary) ---
PORTFOLIOAI_SUPABASE_URL=
PORTFOLIOAI_SUPABASE_PUBLISHABLE_KEY=

# --- Browser/service-role separation ---
# The browser never receives a service-role credential.
# Supabase Edge Functions receive SUPABASE_SERVICE_ROLE_KEY from Supabase's own
# server-side environment; do not add it to frontend/local public configuration.

# --- Angel One SmartAPI: Supabase Edge Function Secrets ONLY ---
# ANGEL_ONE_API_KEY=
# ANGEL_ONE_CLIENT_CODE=
# ANGEL_ONE_PIN=
# ANGEL_ONE_TOTP_SECRET=
# ANGEL_ONE_CLIENT_LOCAL_IP=
# ANGEL_ONE_CLIENT_PUBLIC_IP=
# ANGEL_ONE_MAC_ADDRESS=

# --- Other later providers ---
# TRENDLYNE_API_KEY=
# OPENAI_API_KEY=

# --- Feature gate for Migration 10 (missing trade dates) ---
# VITE_M10_NULL_DATE_COMMIT=true

# --- Feature gate for Migration 11 (missing broker account) ---
# VITE_M11_NULL_BROKER_COMMIT=true
